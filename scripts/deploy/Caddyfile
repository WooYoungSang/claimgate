mofa.warvis.org {
	root * {$CLAIMGATE_SITE_ROOT:/srv/claimgate/current}
	encode zstd gzip

	route {
		@assets path_regexp versioned_assets \.(?:css|js|mjs|svg|png|jpe?g|webp|woff2?)$
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@documents not path_regexp versioned_assets \.(?:css|js|mjs|svg|png|jpe?g|webp|woff2?)$
		header @documents Cache-Control "no-cache, no-store, must-revalidate"

		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
