#!/usr/bin/env node
import { spawnSync } from 'node:child_process';

function run(pack) {
  const result = spawnSync('pnpm', ['--filter', '@claimgate/example-civic-review-app', 'demo', '--', `--pack=${pack}`], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe']
  });
  if (result.status !== 0) {
    process.stderr.write(result.stderr);
    process.exit(result.status ?? 1);
  }
  const storyStart = result.stdout.indexOf('ClaimGate demo:');
  if (storyStart < 0) {
    console.error(`Pack '${pack}' produced no formatted ClaimGate story.`);
    process.exit(1);
  }
  return result.stdout.slice(storyStart).trim();
}

const packIds = ['civic-data', 'health-data', 'mofa-oda'];
const outputs = packIds.map((packId) => [packId, run(packId)]);

for (const [packId, output] of outputs) {
  console.log(`--- ${packId} ---`);
  console.log(output);
}

if (new Set(outputs.map(([, output]) => output)).size !== outputs.length) {
  console.error('Pack swap failed: at least two pack outputs are identical.');
  process.exit(1);
}

console.log('Three-pack swap demo changed behavior without core/UI changes.');
