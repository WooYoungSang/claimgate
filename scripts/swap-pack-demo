#!/usr/bin/env node
import { spawnSync } from 'node:child_process';

function run(pack) {
  const result = spawnSync('pnpm', ['--filter', '@claimgate/example-civic-review-app', 'demo', '--', `--pack=${pack}`], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe']
  });
  if (result.status !== 0) {
    process.stderr.write(result.stderr);
    process.exit(result.status ?? 1);
  }
  const storyStart = result.stdout.indexOf('ClaimGate 데모:');
  if (storyStart < 0) {
    console.error(`팩 '${pack}'에서 형식화된 ClaimGate 이야기를 만들지 못했습니다.`);
    process.exit(1);
  }
  return result.stdout.slice(storyStart).trim();
}

const packIds = ['civic-data', 'health-data', 'mofa-oda'];
const outputs = packIds.map((packId) => [packId, run(packId)]);

for (const [packId, output] of outputs) {
  console.log(`--- ${packId} 팩 ---`);
  console.log(output);
}

if (new Set(outputs.map(([, output]) => output)).size !== outputs.length) {
  console.error('팩 교체 실패: 두 개 이상의 팩 출력이 같습니다.');
  process.exit(1);
}

console.log('세 가지 팩 교체 데모가 core/UI 변경 없이 서로 다른 동작을 보였습니다.');
