{
  "name": "warvis-claimgate",
  "version": "0.0.0",
  "private": true,
  "description": "Source-grounded claim review toolkit for public-data AI outputs.",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "demo": "node scripts/swap-pack-demo",
    "lint": "node scripts/lint-boundaries.mjs && pnpm -r --sort --if-present lint",
    "test": "pnpm build && pnpm -r --sort --if-present test && pnpm test:runbook && pnpm test:clean-clone:contract && pnpm test:clean-clone:self && pnpm test:deployment && pnpm test:submission-evidence",
    "test:runbook": "node --test scripts/validate-demo-runbook.test.mjs && node scripts/validate-demo-runbook.mjs",
    "test:clean-clone:contract": "node --test scripts/verify-clean-clone.test.mjs",
    "test:clean-clone:self": "node scripts/verify-clean-clone.mjs --self-test",
    "verify:clean-clone": "node scripts/verify-clean-clone.mjs",
    "test:deployment": "node --test scripts/deploy/release.test.mjs scripts/deploy/smoke.test.mjs && node scripts/deploy/smoke.mjs --config-only",
    "probe:deployment": "node scripts/deploy/smoke.mjs --url https://mofa.warvis.org",
    "deploy:static": "node scripts/deploy/release.mjs",
    "test:geometry": "pnpm --filter @claimgate/example-civic-review-app build && node scripts/browser-geometry-audit.mjs",
    "test:geometry:cleanup": "node scripts/browser-geometry-audit.mjs --cleanup-self-test",
    "test:judge-flow": "pnpm --filter @claimgate/example-civic-review-app build && node scripts/browser-geometry-audit.mjs --judge-flow",
    "typecheck": "pnpm -r --sort --if-present typecheck",
    "test/conformance": "pnpm --filter @claimgate/conformance test && pnpm --filter @claimgate/pack-civic-data test && pnpm --filter @claimgate/pack-health-data test && pnpm --filter @claimgate/pack-mofa-oda test",
    "test:e2e": "pnpm build && tsx scripts/handoff-smoke.ts",
    "test:handoff": "pnpm test:e2e",
    "test:perf": "pnpm build && tsx scripts/framework-performance-eval.ts",
    "eval:framework": "pnpm lint && pnpm typecheck && pnpm test && pnpm demo && pnpm test/conformance && pnpm test:e2e && pnpm test:perf",
    "test:submission-control-plane": "node scripts/validate-submission-control-plane.mjs",
    "test:simulation-qa": "node scripts/run-simulation-qa.mjs",
    "test:submission-evidence": "node --test scripts/validate-mofa-submission-evidence.test.mjs && node scripts/validate-mofa-submission-evidence.mjs && node scripts/validate-contest-overclaims.mjs && pnpm test:video-preflight",
    "build:kbctl": "cd tools/kbctl && GOFLAGS=-buildvcs=false go build -trimpath -o ../../kbctl .",
    "test:kbctl": "cd tools/kbctl && GOFLAGS=-buildvcs=false go test ./... && GOFLAGS=-buildvcs=false go vet ./... && GOFLAGS=-buildvcs=false go build -trimpath -o ../../kbctl . && cd ../.. && ./kbctl verify",
    "fmon": "./fmon",
    "test:fmon": "cd tools/fmon && GOFLAGS=-buildvcs=false go test ./... && GOFLAGS=-buildvcs=false go vet ./... && GOFLAGS=-buildvcs=false go build -o /dev/null .",
    "test:tooling": "pnpm test:kbctl && pnpm test:fmon",
    "build:final-presentation": "python3 scripts/generate-mofa-final-presentation.py && mkdir -p /tmp/claimgate-final-presentation && libreoffice --headless --convert-to pdf --outdir /tmp/claimgate-final-presentation artifacts/submission/2026-mofa-ai/final-presentation/claimgate-oda-final-presentation.pptx && cp /tmp/claimgate-final-presentation/claimgate-oda-final-presentation.pdf artifacts/submission/2026-mofa-ai/final-presentation/claimgate-oda-final-presentation.pdf && python3 scripts/package-mofa-final-presentation.py",
    "test:final-presentation": "python3 scripts/validate-mofa-final-presentation.py",
    "build:osscontest-report": "python3 scripts/generate-osscontest-final-report.py && python3 scripts/package-osscontest-final.py",
    "test:osscontest-final": "python3 scripts/validate-osscontest-final.py",
    "build:osscontest-sbom": "python3 scripts/generate-osscontest-sbom.py",
    "test:osscontest-license": "python3 scripts/validate-osscontest-license.py",
    "demo:ai": "CLAIMGATE_LOCAL_LLM_PROVIDER=ollama CLAIMGATE_LOCAL_LLM_MODEL=${CLAIMGATE_LOCAL_LLM_MODEL:-gemma4:12b} tsx scripts/ai-claim-demo.ts --provider=ollama",
    "test:ai-demo": "node --test scripts/ai-claim-demo.test.mjs scripts/local-gemma-pipeline.test.mjs",
    "demo:ai:gemma": "CLAIMGATE_LOCAL_LLM_PROVIDER=ollama CLAIMGATE_LOCAL_LLM_MODEL=${CLAIMGATE_LOCAL_LLM_MODEL:-gemma4:12b} tsx scripts/ai-claim-demo.ts --provider=ollama",
    "demo:ai:lora": "CLAIMGATE_GEMMA_LORA_ADAPTER=artifacts/local-ai/gemma-candidate-lora-serving-ready pnpm demo:ai:gemma",
    "rag:build:mofa": "tsx scripts/build-local-rag-index.ts",
    "tune:dataset:mofa": "tsx scripts/build-gemma-tuning-dataset.ts",
    "tune:preflight": "bash -o pipefail -c 'tsx scripts/gemma-tuning-preflight.ts --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --python artifacts/local-ai/gemma-train-venv/bin/python --base-model google/gemma-4-12B-it | tee artifacts/local-ai/gemma-tuning-preflight-latest.json'",
    "audit:harness:gpt56": "node scripts/audit-harness-gpt56.mjs",
    "test:contest-overclaims": "node scripts/validate-contest-overclaims.mjs",
    "test:video-preflight": "node --test scripts/validate-video-preflight.test.mjs && node scripts/validate-video-preflight.mjs",
    "tune:train:smoke": "HF_HOME=artifacts/local-ai/hf-cache TRANSFORMERS_CACHE=artifacts/local-ai/hf-cache artifacts/local-ai/gemma-train-venv/bin/python scripts/train-gemma-candidate-lora.py --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --base-model google/gemma-4-12B-it --out artifacts/local-ai/gemma-candidate-lora-smoke --max-steps 1 --max-seq-length 512",
    "tune:eval:lora": "node scripts/validate-gemma-lora-artifact.mjs --adapter artifacts/local-ai/gemma-candidate-lora-smoke --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --out artifacts/local-ai/gemma-lora-artifact-eval-latest.json",
    "tune:train:prototype": "HF_HOME=artifacts/local-ai/hf-cache TRANSFORMERS_CACHE=artifacts/local-ai/hf-cache artifacts/local-ai/gemma-train-venv/bin/python scripts/train-gemma-candidate-lora.py --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --base-model google/gemma-4-12B-it --out artifacts/local-ai/gemma-candidate-lora-prototype --max-steps 20 --max-seq-length 768",
    "tune:eval:prototype": "node scripts/validate-gemma-lora-artifact.mjs --adapter artifacts/local-ai/gemma-candidate-lora-prototype --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --out artifacts/local-ai/gemma-candidate-lora-prototype-eval.json",
    "tune:infer:prototype:dry-run": "HF_HOME=artifacts/local-ai/hf-cache TRANSFORMERS_CACHE=artifacts/local-ai/hf-cache artifacts/local-ai/gemma-train-venv/bin/python scripts/eval-gemma-lora-candidate.py --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --base-model google/gemma-4-12B-it --adapter artifacts/local-ai/gemma-candidate-lora-prototype --out artifacts/local-ai/gemma-candidate-lora-prototype-infer-dry-run.json --dry-run",
    "tune:infer:prototype": "HF_HOME=artifacts/local-ai/hf-cache TRANSFORMERS_CACHE=artifacts/local-ai/hf-cache artifacts/local-ai/gemma-train-venv/bin/python scripts/eval-gemma-lora-candidate.py --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --base-model google/gemma-4-12B-it --adapter artifacts/local-ai/gemma-candidate-lora-prototype --out artifacts/local-ai/gemma-candidate-lora-prototype-infer-eval.json --max-examples 3 --max-new-tokens 256 --max-seq-length 1024",
    "tune:train:serving": "HF_HOME=artifacts/local-ai/hf-cache TRANSFORMERS_CACHE=artifacts/local-ai/hf-cache artifacts/local-ai/gemma-train-venv/bin/python scripts/train-gemma-candidate-lora.py --dataset artifacts/local-ai/gemma-candidate-tuning.jsonl --base-model google/gemma-4-12B-it --out artifacts/local-ai/gemma-candidate-lora-serving-ready --max-steps 60 --max-seq-length 768",
    "tune:infer:serving": "HF_HOME=artifacts/local-ai/hf-cache TRANSFORMERS_CACHE=artifacts/local-ai/hf-cache artifacts/local-ai/gemma-train-venv/bin/python scripts/eval-gemma-lora-candidate.py --dataset artifacts/local-ai/gemma-candidate-holdout.jsonl --base-model google/gemma-4-12B-it --adapter artifacts/local-ai/gemma-candidate-lora-serving-ready --out artifacts/local-ai/gemma-candidate-lora-serving-ready-holdout-eval.json --max-examples 3 --max-new-tokens 256 --max-seq-length 1024"
  },
  "keywords": [
    "claimgate",
    "source-grounded",
    "claim-review",
    "public-data",
    "evidence-pack"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
