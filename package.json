{
  "name": "warvis-claimgate",
  "version": "0.0.0",
  "private": true,
  "description": "Source-grounded claim review toolkit for public-data AI outputs.",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "demo": "node scripts/swap-pack-demo",
    "lint": "node scripts/lint-boundaries.mjs && pnpm -r --sort --if-present lint",
    "test": "pnpm build && pnpm -r --sort --if-present test",
    "test:geometry": "pnpm --filter @claimgate/example-civic-review-app build && node scripts/browser-geometry-audit.mjs",
    "test:geometry:cleanup": "node scripts/browser-geometry-audit.mjs --cleanup-self-test",
    "typecheck": "pnpm -r --sort --if-present typecheck",
    "test/conformance": "pnpm --filter @claimgate/conformance test && pnpm --filter @claimgate/pack-civic-data test && pnpm --filter @claimgate/pack-health-data test && pnpm --filter @claimgate/pack-mofa-oda test",
    "test:e2e": "pnpm build && tsx scripts/handoff-smoke.ts",
    "test:handoff": "pnpm test:e2e",
    "test:perf": "pnpm build && tsx scripts/framework-performance-eval.ts",
    "eval:framework": "pnpm lint && pnpm typecheck && pnpm test && pnpm demo && pnpm test/conformance && pnpm test:e2e && pnpm test:perf",
    "test:submission-control-plane": "node scripts/validate-submission-control-plane.mjs",
    "test:simulation-qa": "node scripts/run-simulation-qa.mjs"
  },
  "keywords": [
    "claimgate",
    "source-grounded",
    "claim-review",
    "public-data",
    "evidence-pack"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
